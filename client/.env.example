# Full Evennia portal WebSocket URL (omit to use Vite dev proxy, or hostname:4002 in production builds).
# Examples:
# VITE_EVENNIA_WS_URL=ws://127.0.0.1:4002
# VITE_EVENNIA_WS_URL=ws://192.168.1.10:4002

# Vite dev: HTTP proxy target for /evennia-portal → portal (session cookie for webclient bootstrap).
# VITE_EVENNIA_PORTAL_PROXY_TARGET=http://127.0.0.1:4001

# Production / remote: absolute origin for GET /webclient/ (must allow CORS credentials if cross-origin).
# VITE_EVENNIA_PORTAL_ORIGIN=http://127.0.0.1:4001
